{
  "name": "duxcasino",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@duxcasino/web",
    "dev:native": "turbo run dev --filter=@duxcasino/native",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "shoot": "PLAYWRIGHT_BROWSERS_PATH=\"$INIT_CWD/.browsers\" tsx scripts/shoot.ts",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^20.16.5",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.47.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0"
  },
  "resolutions": {
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11"
  }
}
